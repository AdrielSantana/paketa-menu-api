{
  "name": "live-coding-boiler-plate",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "start": "tsx watch src/index.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "cd .. && husky backend-desafio/.husky",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paketacredito/live-coding-boiler-plate.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/paketacredito/live-coding-boiler-plate/issues"
  },
  "homepage": "https://github.com/paketacredito/live-coding-boiler-plate#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.2",
    "yup": "^1.7.1"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
